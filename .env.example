DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=
FLW_SECRET_KEY=
FLW_PUBLIC_KEY=
FLW_WEBHOOK_HASH=
NEXT_PUBLIC_FLW_PUBLIC_KEY=
NEXT_PUBLIC_API_URL=
FRONTEND_URL=
NODE_ENV=development

# Comma-separated allowlist — there is no dedicated ADMIN role in the schema
# yet, so admin-only marketplace routes (provider verification, internal
# staff onboarding) gate on whether the authenticated user's email appears
# here. e.g. ADMIN_EMAILS=founder@beyondagency.ng,partner@beyondagency.ng
ADMIN_EMAILS=

# Optional — email notifications (e.g. new in-app message). Without this,
# the app still works fully; notifications just log instead of sending.
# Get a key at https://resend.com
RESEND_API_KEY=
# Sending "from" an address requires verifying you own that domain —
# defaults to Resend's no-verification-needed sandbox sender.
EMAIL_FROM=BeyondAgency <onboarding@resend.dev>
# Where "reply" on a notification email actually lands, since the from
# address above isn't a real inbox.
EMAIL_REPLY_TO=granjefetech@gmail.com
