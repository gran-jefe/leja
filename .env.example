DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=

# Payment rail: eTranzact (replaced Flutterwave — see apps/api/src/lib/payments/
# for the provider-agnostic layer this backs). PAYMENT_PROVIDER selects which
# implementation is active; "etranzact" is currently the only one wired up.
PAYMENT_PROVIDER=etranzact
ETRANZACT_SECRET_KEY=
ETRANZACT_PRODUCT_CODE=
ETRANZACT_WEBHOOK_SECRET=
# Override once production credentials/host are issued — defaults to the
# demo host documented at developers.etranzactng.com.
ETRANZACT_BASE_URL=https://demo.etranzact.com/virtual-funding

# Phase 2 groundwork — identity verification (see apps/api/src/lib/identity/).
# No real KYC provider is integrated yet; "stub" auto-approves everything and
# must never be used in production. Leave unset in dev to get the same effect.
KYC_PROVIDER=stub

NEXT_PUBLIC_API_URL=
FRONTEND_URL=
NODE_ENV=
# API port. render.yaml declares 5000; Render also injects its own PORT, so
# don't paste a local override (e.g. 5001) into the dashboard.
PORT=development

# Comma-separated allowlist — there is no dedicated ADMIN role in the schema
# yet, so admin-only marketplace routes (provider verification, internal
# staff onboarding) gate on whether the authenticated user's email appears
# here. e.g. ADMIN_EMAILS=founder@beyondagency.ng,partner@beyondagency.ng
ADMIN_EMAILS=

# Optional — email notifications (e.g. new in-app message). Without this,
# the app still works fully; notifications just log instead of sending.
# Get a key at https://resend.com
RESEND_API_KEY=
# Sending "from" an address requires verifying you own that domain —
# defaults to Resend's no-verification-needed sandbox sender.
EMAIL_FROM=BeyondAgency <onboarding@resend.dev>
# Where "reply" on a notification email actually lands, since the from
# address above isn't a real inbox.
EMAIL_REPLY_TO=granjefetech@gmail.com

# ---------------------------------------------------------------------------
# ⚠️  PRODUCTION OVERRIDES — do NOT paste this file verbatim into Render.
#
# These five are correct for local development and wrong (one of them
# breaking) in production:
#
#   NODE_ENV=production
#       Anything else and config.cors.allowedOrigins falls back to
#       ['http://localhost:3000', ...] — the deployed frontend is then blocked
#       by CORS and the API is unreachable from the web app. It also skips the
#       eTranzact credential check in validateConfig().
#
#   FRONTEND_URL=https://leja.ng
#       The API builds tenant invite/redirect links from this. Left on
#       localhost, every invite link sent from production is dead.
#
#   PORT=5000
#       Matches render.yaml and the /health check.
#
#   ETRANZACT_BASE_URL=<live host>
#       Defaults to eTranzact's *demo* host — real payments would hit sandbox.
#
#   NEXT_PUBLIC_API_URL — a frontend variable. Belongs on Vercel, not Render,
#       and must point at the deployed API, not localhost.
#
# Also: SUPABASE_DB_PASSWORD is only read by the Supabase CLI, never by the
# API. Don't set it on Render — it just puts the database password in one
# more place.
# ---------------------------------------------------------------------------
